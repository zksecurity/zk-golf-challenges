def compressionInputWords (v : CompressionVector) : Vector ℕ 28 :=
  v.cv ++ v.block ++ #v[v.counterLow, v.counterHigh, v.blockLen, v.flags]

-- Word-level compression itself, independently of hash/chunk/tree processing.
example : ∀ i : Fin 8,
    let v := compressionVectors[i.val]
    compress v.cv v.block (v.counterLow + 2 ^ 32 * v.counterHigh)
      v.blockLen v.flags = v.output := by
  native_decide

example :
    compress iv (Vector.replicate 16 0) 0 0
        (chunkStart ||| chunkEnd ||| root) = emptyRootBlock0 := by
  native_decide

example :
    compress iv (Vector.replicate 16 0) 1 0
        (chunkStart ||| chunkEnd ||| root) = emptyRootBlock1 := by
  native_decide

-- The same pin for the 3-byte message [0, 1, 2]: a single block with the
-- word 0x020100 and byte length 3.
example :
    compress iv ((Vector.replicate 16 0).set 0 0x020100) 0 3
        (chunkStart ||| chunkEnd ||| root) = threeByteRootBlock0 := by
  native_decide

-- Chunk and parent chaining values, generated with the Rust implementation's
-- hazmat API (finalize_non_root, set_input_offset, and
-- merge_subtrees_non_root): these pin the tree layers individually rather
-- than only through root digests.

-- The non-root chaining value of the single chunk holding tvInput 1024.
example :
    chainingValue (chunkOutput iv 0 0 (tvInput 1024).toList) =
      #v[
        0x44659e5c, 0xd193e311, 0x10c7bef4, 0x56bcd5cc,
        0x7d17ab69, 0xb60e0a61, 0xe9fefc91, 0xb1e8b42f
      ] := by
  native_decide

-- The chaining values of the two chunks of tvInput 2048 (the second chunk
-- is compressed with chunk counter 1) ...
def tv2048Cv0 : Vector ℕ 8 := #v[
  0x44659e5c, 0xd193e311, 0x10c7bef4, 0x56bcd5cc,
  0x7d17ab69, 0xb60e0a61, 0xe9fefc91, 0xb1e8b42f
]

def tv2048Cv1 : Vector ℕ 8 := #v[
  0xb8231f5b, 0xa2680339, 0x919550c1, 0xb7d18903,
  0xa652eb16, 0x0a4dd3df, 0xa2226aa6, 0xa71c761b
]

example :
    chainingValue (chunkOutput iv 0 0 ((tvInput 2048).toList.take 1024)) =
      tv2048Cv0 := by
  native_decide

example :
    chainingValue (chunkOutput iv 0 1 ((tvInput 2048).toList.drop 1024)) =
      tv2048Cv1 := by
  native_decide

-- ... their parent combination ...
example :
    chainingValue (parentOutput iv 0 tv2048Cv0 tv2048Cv1) =
      #v[
        0x4f7d1f81, 0x8e253517, 0x928bc627, 0x4a7cff14,
        0x476d86ac, 0xf1ee3df7, 0xb50889fd, 0x4f808fe3
      ] := by
  native_decide

-- ... and the shape of the two-chunk root node: a parent block made of the
-- two concatenated chunk chaining values.
example :
    subtreeOutput iv 0 0 (tvInput 2048).toList =
      parentOutput iv 0 tv2048Cv0 tv2048Cv1 := by
  native_decide

-- The bit-level compression interface: the 28 input words (chaining value,
-- message block, counter halves, block length, flags) packed little-endian
-- into 896 bits, and the 16 output words into 512 bits.

-- wordsToBits/bitsToWords bit order: bit 32·i + j of the string is bit j of
-- word i, which coincides with the little-endian byte serialization (bit
-- 8·k + b is bit b of byte k).
example : (wordsToBits (bytesToBlock [0x01, 0x80]))[0] = 1 := by native_decide
example : (wordsToBits (bytesToBlock [0x01, 0x80]))[1] = 0 := by native_decide
example : (wordsToBits (bytesToBlock [0x01, 0x80]))[15] = 1 := by native_decide

example :
    wordsToBits (#v[0x80000001] : Vector ℕ 1) =
      ((Vector.replicate 32 0).set 0 1).set 31 1 := by
  native_decide

example :
    bitsToWords 1 (((Vector.replicate 32 0).set 0 1).set 31 1) =
      #v[0x80000001] := by
  native_decide

-- words ↔ bits roundtrip on the official key words.
example : bitsToWords 8 (wordsToBits (keyWords tvKey)) = keyWords tvKey := by
  native_decide

-- The raw-bit wrapper agrees on all eight compression-only vectors. Counter
-- words are serialized low half first.
example : ∀ i : Fin 8,
    let v := compressionVectors[i.val]
    compressBits (wordsToBits (compressionInputWords v)) =
      wordsToBits v.output := by
  native_decide

-- Direct cross-implementation bridge on the Rust-crate vectors: the
-- independent GF(2) challenge semantics agrees with the natural-number
-- `compressBits` specification after the explicit bit-to-field conversion.
example : ∀ i : Fin 8,
    let input := wordsToBits (compressionInputWords compressionVectors[i.val])
    Challenge.Instances.Blake3CompressGF2Canonical.Interface.Blake3Bits.compress
      (natBitsToF2 input) =
      natBitsToF2 (compressBits input) := by
  native_decide

-- compressBits agrees with the word-level compression on the empty root
-- block (input words iv ‖ 0¹⁶ ‖ [0, 0, 0, chunkStart ||| chunkEnd ||| root],
-- whose output is pinned to official bytes above) ...
example :
    compressBits (wordsToBits
        (iv ++ Vector.replicate 16 0 ++
          #v[0, 0, 0, chunkStart ||| chunkEnd ||| root])) =
      wordsToBits emptyRootBlock0 := by
  native_decide

-- ... and on the root (parent) node of the 2048-byte input: block = the two
-- chunk chaining values, counter words 0, block length 64, flags
-- parent ||| root; the output bits are the first 64 bytes of the official
-- extended output for the 2048-byte input.
example :
    compressBits (wordsToBits
        (iv ++ (tv2048Cv0 ++ tv2048Cv1) ++ #v[0, 0, 64, parent ||| root])) =
      wordsToBits tv2048RootBlock0 := by
  native_decide

-- The challenge's independent GF(2) definition is checked against the same
-- compression vectors generated/reverified by the official Rust `blake3`
-- crate. These tests also pin the bit-to-field conversion used by the
-- 896-bit challenge interface.
example : ∀ i : Fin 8,
    let v := compressionVectors[i.val]
    Challenge.Instances.Blake3CompressGF2Canonical.Interface.Blake3Bits.compress
      (natBitsToF2 (wordsToBits (compressionInputWords v))) =
      natBitsToF2 (wordsToBits v.output) := by
  native_decide

example :
    Challenge.Instances.Blake3CompressGF2Canonical.Interface.Blake3Bits.compress
      (natBitsToF2 (wordsToBits
        (iv ++ Vector.replicate 16 0 ++
          #v[0, 0, 0, chunkStart ||| chunkEnd ||| root]))) =
      natBitsToF2 (wordsToBits emptyRootBlock0) := by
  native_decide

example :
    Challenge.Instances.Blake3CompressGF2Canonical.Interface.Blake3Bits.compress
      (natBitsToF2 (wordsToBits
        (iv ++ ((Vector.replicate 16 0).set 0 0x020100) ++
          #v[0, 0, 3, chunkStart ||| chunkEnd ||| root]))) =
      natBitsToF2 (wordsToBits threeByteRootBlock0) := by
  native_decide

example :
    Challenge.Instances.Blake3CompressGF2Canonical.Interface.Blake3Bits.compress
      (natBitsToF2 (wordsToBits
        (iv ++ (tv2048Cv0 ++ tv2048Cv1) ++
          #v[0, 0, 64, parent ||| root]))) =
      natBitsToF2 (wordsToBits tv2048RootBlock0) := by
  native_decide

-- The compression maps bit strings to bit strings.
example :
    IsBitString (compressBits (wordsToBits
      (iv ++ Vector.replicate 16 0 ++
        #v[0, 0, 0, chunkStart ||| chunkEnd ||| root]))) := by
  native_decide

-- CompressSpec relates the raw input bits to the compression output bits,
-- and CompressAssumptions requires a bit-string input.
example :
    CompressSpec (wordsToBits
        (iv ++ Vector.replicate 16 0 ++
          #v[0, 0, 0, chunkStart ||| chunkEnd ||| root]))
      (wordsToBits emptyRootBlock0) := by
  simp only [CompressSpec]
  native_decide

example :
    ¬ CompressSpec (wordsToBits
        (iv ++ Vector.replicate 16 0 ++
          #v[0, 0, 0, chunkStart ||| chunkEnd ||| root]))
      (wordsToBits emptyRootBlock1) := by
  simp only [CompressSpec]
  native_decide

example :
    CompressAssumptions (wordsToBits
      (iv ++ Vector.replicate 16 0 ++
        #v[0, 0, 0, chunkStart ||| chunkEnd ||| root])) := by
  simp only [CompressAssumptions]
  native_decide

example :
