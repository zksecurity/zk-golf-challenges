-- permute moves message word σ(i) to position i, exposing the full
-- permutation table σ = [2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14,
-- 15, 8] on the marker block m[i] = i.
example :
    permute (Vector.ofFn fun i => i.val) =
      #v[2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8] := by
  native_decide

-- g fixes the all-zero state when the message words are zero.
example : g (Vector.replicate 16 0) 0 4 8 12 0 0 = Vector.replicate 16 0 := by
  native_decide

-- Block and chunk counting: a chunk holds up to 1024 bytes in up to 16
-- 64-byte blocks, and empty inputs still occupy one block / one chunk.
example : numBlocks 0 = 1 := by native_decide
example : numBlocks 1 = 1 := by native_decide
example : numBlocks 64 = 1 := by native_decide
example : numBlocks 65 = 2 := by native_decide
example : numBlocks 128 = 2 := by native_decide
example : numBlocks 129 = 3 := by native_decide
example : numBlocks 1023 = 16 := by native_decide
example : numBlocks 1024 = 16 := by native_decide

example : numChunks 0 = 1 := by native_decide
example : numChunks 1 = 1 := by native_decide
example : numChunks 1024 = 1 := by native_decide
example : numChunks 1025 = 2 := by native_decide
example : numChunks 2048 = 2 := by native_decide
example : numChunks 2049 = 3 := by native_decide
example : numChunks 102400 = 100 := by native_decide

-- The left subtree takes the largest power of two strictly below the chunk
-- count: for 2, ..., 9 chunks that is 1, 2, 2, 4, 4, 4, 4, 8.
example :
    (Vector.ofFn fun i : Fin 8 => leftChunks (i.val + 2)) =
      #v[1, 2, 2, 4, 4, 4, 4, 8] := by
  native_decide

-- The compression function pinned against official bytes. The empty message
-- is a single empty chunk, so its root block has input CV = iv, an all-zero
-- block, length 0, and flags chunkStart ||| chunkEnd ||| root; its 16
-- output words, re-serialized as little-endian bytes, are the first 64
-- bytes of the official extended output for the empty input, and output
-- block counter 1 yields bytes 64..128. The analogous root blocks of the
-- 3-byte message and of the 2048-byte message (a parent node) pin nonzero
-- blocks, lengths, and flags.
