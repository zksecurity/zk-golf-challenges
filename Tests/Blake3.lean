import Challenge.Instances.Blake3CompressGF2Canonical.Interface

namespace Specs.Blake3.Tests

/-
  Test vectors from two sources:

  * The official BLAKE3 test vectors (BLAKE3-team/BLAKE3,
    test_vectors/test_vectors.json), covering the hash, keyed_hash, and
    derive_key modes. Every official input is a prefix of the repeating
    byte pattern 0, 1, ..., 250, 0, 1, ..., and the official lengths
    exercise every block and chunk boundary (63/64/65, 1023/1024/1025, ...)
    plus a range of tree shapes up to 100 chunks (102400 bytes). Each
    official output is a 131-byte extended output whose first 32 bytes are
    the default digest; the keyed_hash key is the 32-byte ASCII string
    "whats the Elvish word for friend" and the derive_key context string is
    "BLAKE3 2019-12-27 16:29:52 test vectors context".

  * Vectors generated with the official Rust implementation (the `blake3`
    crate): digests of ASCII strings, of all-0xff inputs (the official
    pattern never produces bytes above 250), and chunk/parent chaining
    values obtained through the crate's `hazmat` API, which pin the tree
    layers individually. The generator re-verifies every official test
    vector against the crate before printing the literals below.
-/

/-- The official test-vector input pattern: bytes 0, 1, ..., 250, 0, 1, ... -/
def tvInput (n : ℕ) : Vector ℕ n := Vector.ofFn fun i => i.val % 251

/-- Interpret a natural-number bit vector as a vector over `F 2`. -/
def natBitsToF2 {n : ℕ} (bits : Vector ℕ n) : Vector (F 2) n :=
  Vector.ofFn fun i => if bits[i.val] = 0 then 0 else 1

-- "whats the Elvish word for friend": the official keyed_hash key.
def tvKey : Vector ℕ 32 := #v[
  0x77, 0x68, 0x61, 0x74, 0x73, 0x20, 0x74, 0x68, 0x65, 0x20,
  0x45, 0x6c, 0x76, 0x69, 0x73, 0x68, 0x20, 0x77, 0x6f, 0x72,
  0x64, 0x20, 0x66, 0x6f, 0x72, 0x20, 0x66, 0x72, 0x69, 0x65,
  0x6e, 0x64
]

-- "BLAKE3 2019-12-27 16:29:52 test vectors context": the official
-- derive_key context string.
def tvContext : Vector ℕ 47 := #v[
  0x42, 0x4c, 0x41, 0x4b, 0x45, 0x33, 0x20, 0x32, 0x30, 0x31,
  0x39, 0x2d, 0x31, 0x32, 0x2d, 0x32, 0x37, 0x20, 0x31, 0x36,
  0x3a, 0x32, 0x39, 0x3a, 0x35, 0x32, 0x20, 0x74, 0x65, 0x73,
  0x74, 0x20, 0x76, 0x65, 0x63, 0x74, 0x6f, 0x72, 0x73, 0x20,
  0x63, 0x6f, 0x6e, 0x74, 0x65, 0x78, 0x74
]

-- Helper function unit tests.

-- wordAt packs four bytes in little-endian order and zero-pads past the end.
example : wordAt [0x78, 0x56, 0x34, 0x12] 0 = 0x12345678 := by native_decide
example : wordAt [0xef, 0xbe, 0xad, 0xde] 0 = 0xdeadbeef := by native_decide
example : wordAt [] 0 = 0 := by native_decide
example : wordAt [0x01, 0x02] 0 = 0x0201 := by native_decide
example : wordAt [0, 0, 0, 0, 0xaa] 1 = 0xaa := by native_decide

-- bytesToBlock reads 16 little-endian words and zero-pads short blocks.
example : bytesToBlock [] = Vector.replicate 16 0 := by native_decide
example :
    bytesToBlock [0x61, 0x62, 0x63] =
      (Vector.replicate 16 0).set 0 0x636261 := by
  native_decide
example : bytesToBlock (tvInput 64).toList = #v[
